                texture = "gfx/interface/icons/company_icons/company_backgrounds/comp_illu_oil_drills.dds"
                using = simple_frame_mask
                alpha = 0.6
            }
            hbox = {
                layoutpolicy_horizontal = expanding
                margin = { 5 5 }
                hbox = {
                    margin_top = 0
                    background = {
                        using = fade_right_simple
                    }

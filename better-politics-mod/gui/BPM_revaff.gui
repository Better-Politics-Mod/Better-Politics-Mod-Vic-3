types politics_panel_types
{
    type bpm_icon_revaff = container {
        datacontext = "[InterestGroup]"
        icon = {
            visible = "[Or(Not(InterestGroup.MakeScope.Var('bpm_action').IsSet), Not(InterestGroup.MakeScope.Var('bpm_action').GetScriptContainer.IsValid))]"
            texture = "gfx/interface/icons/ig_icons/politically_unaligned.dds"
            size = { 26 26 }
            tooltipwidget = {
                RegularTooltip_FrontAttract = {}
            }
        }
        icon = {
            visible = "[And(InterestGroup.MakeScope.Var('bpm_action').IsSet, InterestGroup.MakeScope.Var('bpm_action').GetScriptContainer.IsValid)]"
            texture = "[GetInstitutionType(InterestGroup.MakeScope.Var('bpm_action').Var('bpm_action_type').GetFlagName).GetIcon]"
            size = { 32 32 }
            tooltipwidget = {
                RegularTooltip_FrontAttract = {}
            }
        }
    }
}
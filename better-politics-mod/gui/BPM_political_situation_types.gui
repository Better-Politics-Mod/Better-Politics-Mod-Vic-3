@panel_width = 540
@panel_width_minus_10 = 530
@panel_width_minus_20 = 520
@panel_width_minus_40 = 480
@panel_width_plus_10 = 550

# COPY-PASTED FOR NOW
@panel_width_with_icon_space = 440		# used to be 410
@panel_width_half = 270				# used to be 230
@panel_width_plus_14 = 554			# used to be 474
@panel_width_plus_14_half = 277		# used to be 237
@panel_width_plus_70 = 610			# used to be 530

@interest_group_grid_width = 108  # = @panel_width / @interest_group_grid_columns
@interest_group_grid_height = 120
@interest_group_grid_columns = 5

types political_situation_types { 
    type bpm_political_situation_dissent_panel = scrollarea {
        layoutpolicy_vertical = preferred
        layoutpolicy_horizontal = preferred

        scrollbarpolicy_horizontal = always_off

        block "scrollarea_backgrounds" {
        }

        scrollbar_vertical = {
            using = vertical_scrollbar
        }
        scrollwidget = {
            block "scrollarea_content_vbox" {
                container = {
                    name = "content_container"
                    parentanchor = hcenter

                    state = {
                        name = show
                        duration = 0.2
                        alpha = 1
                        using = Animation_Curve_Default
                    }
                    state = {
                        name = hide
                        duration = 0
                        alpha = 0
                    }

                    block "scrollarea_content" {
                        vbox = {
                            #max_update_rate = 20
                            #visible = "[GetVariableSystem.Exists('politics_overview_dissent_panel')]"
                            layoutpolicy_horizontal = expanding
                            layoutpolicy_vertical = growing
                            spacing = 10
                            margin = { 0 10 }

                            # hbox = {
                            #     name = "tutorial_highlight_government_title"
                            #     spacing = 5
                            #     margin = { 5 8 }
                            #     layoutpolicy_horizontal = preferred

                            #     background = {
                            #         using = default_header_bg_faded
                            #     }
                                
                            #     textbox = {
                            #         layoutpolicy_horizontal = expanding
                            #         size = { 0 30 }
                            #         raw_text = "Dissent Situation"
                            #         align = hcenter|nobaseline
                            #         elide = right
                            #         using = fontsize_xxl
                            #         margin_left = 5
                            #     }



                            # }
                            top_illu = {
                                datacontext = "[AccessPlayer]"
                                blockoverride "illu" {
                                    texture = "gfx/interface/illustrations/top_illus/top_illu_companies.dds"
                                }

                                size = { @panel_width_plus_10 120 }

                                flowcontainer = {
                                    direction = vertical
                                    parentanchor = center

                                    textbox = {	
                                        margin_top = 2			
                                        text = "bpm_political_situation_dissent_header"
                                        using = fontsize_xl
                                        using = companies_header_texts
                                    }

                                    textbox = {				
                                        text = "bpm_political_situation_dissent_crises_active"
                                        using = companies_header_texts
                                    }

                                    textbox = {
                                        text = "bpm_political_situation_dissent_crises_preparing"
                                        using = companies_header_texts
                                    }

                                    textbox = {				
                                        text = "bpm_political_situation_dissent_crises_inactive"
                                        using = companies_header_texts
                                    }

                                }
                            }


                            vbox = {
                                default_header_2texts = {
                                    blockoverride "text1" {
                                        text = "bpm_dissent_actions_header"
                                    }
                                    blockoverride "text2" {
                                        text = "bpm_dissent_actions_active_v_potential"
                                    }
                                }
                                flowcontainer = {
                                    direction = vertical
                                    datamodel = "[GetPlayer.MakeScope.GetList('bpm_active_actions')]"

                                    item = {
                                        flowcontainer = {
                                            direction = vertical
                                            visible = no
                                            

                                            flowcontainer = {
                                                datacontext = "[Scope.GetScriptContainer]"
                                                direction = vertical
                                                widget = {
                                                    size = { @panel_width 170 }
                                                    background = {
                                                        using = entry_bg
                                                    }

                                                    flowcontainer = {
                                                        direction = horizontal
                                                        widget = {
                                                            size = { 105 170 }
                                                            parentanchor = vcenter|left
                                                            icon = {
                                                                size = { 95 95 }
                                                                texture = "gfx/interface/icons/action_icons/revolt_action.dds"
                                                                parentanchor = vcenter|right
                                                            }
                                                        }
                                                        flowcontainer = {
                                                            direction = vertical
                                                            spacing = 20
                                                            flowcontainer = {
                                                                direction = vertical
                                                                parentanchor = right

                                                                spacing = 10

                                                                section_header_button = {
                                                                    size = { @panel_width_with_icon_space 40 }
                                                                    blockoverride "left_text" {
                                                                        text = "[Localize(Concatenate(Scope.Var('bpm_action_type').GetFlagName, '_name'))]"
                                                                    }

                                                                    blockoverride "onclick" {
                                                                        onclick = "[GetVariableSystem.Toggle(Scope.Var('bpm_action_type').GetFlagName)]"
                                                                    }

                                                                    blockoverride "onclick_showmore" {
                                                                        visible = "[Not(GetVariableSystem.Exists(Scope.Var('bpm_action_type').GetFlagName))]"
                                                                    }

                                                                    blockoverride "onclick_showless" {
                                                                        visible = "[GetVariableSystem.Exists(Scope.Var('bpm_action_type').GetFlagName)]"
                                                                    }
                                                                }

                                                                widget = { size = { 420 60 }
                                                                    bpm_revolution_progress_bar = {
                                                                        parentanchor = right|bottom
                                                                        size = { 400 25 }
                                                                        blockoverride "header" {
                                                                            textbox = {
                                                                                align = nobaseline
                                                                                autoresize = yes
                                                                                text = "REVOLUTIONS_HEADER"
                                                                            }
                                                                        }

                                                                        blockoverride "values" {
                                                                            value = "[ScriptContainer.MakeScope.Var('bpm_revolt_progress').GetValue]"
                                                                            min = 0
                                                                            max = 100
                                                                        }
                                                                    } 
                                                                    flowcontainer = {
                                                                        direction = horizontal
                                                                        parentanchor = top
                                                                        margin_left = 25
                                                                        spacing = 2
                                                                        datamodel = "[Scope.GetList('bpm_actively_involved')]"
                                                                        item = {
                                                                            ig_icon = {
                                                                                datacontext = "[Scope.GetInterestGroup]"
                                                                                size = { 28 28 }
                                                                            }
                                                                        }
                                                                    }
                                                                    # textbox = {
                                                                    #     size = { 400 30 }
                                                                    #     using = elide_fontsize_min
                                                                    #     align = nobaseline
                                                                    #     autoresize = yes
                                                                    #     maximumsize = { -1 36 }
                                                                    #     minimumsize = { -1 36 }
                                                                    #     default_format = "#v"
                                                                    #     text = "[GetDataModelSize(Scope.GetList('bpm_actively_involved'))]"
                                                                    # }
                                                                }
                                                                widget = {
                                                                    size = { 420 25 }
                                                                    flowcontainer = {
                                                                        parentanchor = hcenter
                                                                        direction = horizontal
                                                                        spacing = 20
                                                                        maximumsize = { 400 -1 }
                                                                        flowcontainer = {
                                                                            direction = horizontal
                                                                            spacing = 5
                                                                            icon = {
                                                                                size = { 36 36 }
                                                                                texture = "gfx/interface/icons/generic_icons/gdp.dds"
                                                                            }

                                                                            textbox = {
                                                                                size = { 40 30 }
                                                                                using = elide_fontsize_min
                                                                                align = nobaseline
                                                                                autoresize = yes
                                                                                maximumsize = { -1 36 }
                                                                                minimumsize = { -1 36 }
                                                                                default_format = "#v"
                                                                                text = "[Scope.ScriptValue('bpm_revolt_action_info_percent_gdp_polmov')|%]"
                                                                            }
                                                                        }
                                                                        flowcontainer = {
                                                                            direction = horizontal
                                                                            spacing = 5

                                                                            icon = {
                                                                                size = { 36 36 }
                                                                                texture = "gfx/interface/icons/generic_icons/conscripts.dds"
                                                                            }

                                                                            textbox = {
                                                                                size = { 40 30 }
                                                                                using = elide_fontsize_min
                                                                                align = nobaseline
                                                                                autoresize = yes
                                                                                maximumsize = { -1 36 }
                                                                                minimumsize = { -1 36 }
                                                                                default_format = "#v"
                                                                                text = "[Scope.ScriptValue('bpm_revolt_action_info_num_barracks_polmov')|0]"
                                                                            }
                                                                        }
                                                                        flowcontainer = {
                                                                            direction = horizontal
                                                                            spacing = 5

                                                                            icon = {
                                                                                size = { 36 36 }
                                                                                texture = "gfx/interface/icons/generic_icons/population.dds"
                                                                            }

                                                                            textbox = {
                                                                                size = { 40 30 }
                                                                                using = elide_fontsize_min
                                                                                align = nobaseline
                                                                                autoresize = yes
                                                                                maximumsize = { -1 36 }
                                                                                minimumsize = { -1 36 }
                                                                                default_format = "#v"
                                                                                text = "[Scope.ScriptValue('bpm_revolt_action_info_percent_population_polmov')|%]"
                                                                            }
                                                                        }
                                                                        flowcontainer = {
                                                                            direction = horizontal
                                                                            spacing = 5

                                                                            icon = {
                                                                                size = { 36 36 }
                                                                                texture = "gfx/interface/icons/generic_icons/state.dds"
                                                                            }

                                                                            textbox = {
                                                                                size = { 26 30 }
                                                                                fontsize_min = 12
                                                                                align = nobaseline
                                                                                autoresize = yes
                                                                                maximumsize = { -1 36 }
                                                                                minimumsize = { -1 36 }
                                                                                default_format = "#v"
                                                                                text = "[Scope.ScriptValue('bpm_number_of_states_with_cells')]"
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                                flowcontainer = {
                                                    direction = vertical
                                                    visible = "[GetVariableSystem.Exists(Scope.Var('bpm_action_type').GetFlagName)]"
                                                    using = expanded_list_bg
                                                    spacing = 15

                                                    blockoverride "dark_area_alpha" {
                                                        alpha = 0.5
                                                    }

                                                    datamodel = "[Scope.GetMapKeys('bpm_revcells')]"
                                                    item = {
                                                        widget = {
                                                            datacontext = "[Scope.GetStateRegion]"
                                                            size = { @panel_width 40 }
                                                            block "background" {
                                                                background = {
                                                                    using = entry_bg_simple
                                                                }
                                                            }
                                                            datacontext = "[StateRegion]"
                                                            datacontext = "[ScriptContainer]"
                                                            tooltip = "bpm_cell_increase_grow_show"

                                                            flowcontainer = {
                                                                minimumsize = { -1 40 }
                                                                direction = horizontal
                                                                spacing = 2
                                                                widget = { size = { 10 -1 }}
                                                                button = {
                                                                    layoutpolicy_horizontal = expanding
                                                                    size = { 220 30 }
                                                                    using = default_button
                                                                    using = tooltip_ne
                                                                    parentanchor = vcenter

                                                                    textbox = {
                                                                        size = { 100% 100% }
                                                                        margin = { 10 0 }
                                                                        text = "[StateRegion.GetName]"
                                                                        parentanchor = vcenter
                                                                        align = nobaseline
                                                                        elide =  right
                                                                    }
                                                                }
                                                                flowcontainer = {
                                                                    direction = horizontal
                                                                    parentanchor = vcenter
                                                                    spacing = 5
                                                                    bpm_cell_level_icon = {
                                                                        blockoverride "growing" {
                                                                            visible = "[GetScriptedGui('bpm_cell_is_growing').IsShown(GuiScope.SetRoot(StateRegion.MakeScope).AddScope('action', ScriptContainer.MakeScope).End)]"
                                                                        }
                                                                        blockoverride "shrinking" {
                                                                            visible = "[Not(GetScriptedGui('bpm_cell_is_growing').IsShown(GuiScope.SetRoot(StateRegion.MakeScope).AddScope('action', ScriptContainer.MakeScope).End))]"
                                                                        }
                                                                    }
                                                                    #Lv 2
                                                                    bpm_cell_level_icon = {
                                                                        blockoverride "visible" {
                                                                            visible = "[EqualTo_CFixedPoint(ScriptContainer.MakeScope.GetVariableFromVariableMap('bpm_revcells', StateRegion.MakeScope).GetValue, '(CFixedPoint)2')]"
                                                                        }
                                                                        blockoverride "texture" {
                                                                            texture = "gfx/interface/icons/tiered_interests/interest_levels_icons/interest_level_2_engaged_small.dds"
                                                                        }
                                                                        blockoverride "growing" {
                                                                            visible = "[GetScriptedGui('bpm_cell_is_growing').IsShown(GuiScope.SetRoot(StateRegion.MakeScope).AddScope('action', ScriptContainer.MakeScope).End)]"
                                                                        }
                                                                        blockoverride "shrinking" {
                                                                            visible = "[Not(GetScriptedGui('bpm_cell_is_growing').IsShown(GuiScope.SetRoot(StateRegion.MakeScope).AddScope('action', ScriptContainer.MakeScope).End))]"
                                                                        }
                                                                    }
                                                                    bpm_cell_level_icon = {
                                                                        blockoverride "visible" {
                                                                            visible = "[EqualTo_CFixedPoint(ScriptContainer.MakeScope.GetVariableFromVariableMap('bpm_revcells', StateRegion.MakeScope).GetValue, '(CFixedPoint)3')]"
                                                                        }
                                                                        blockoverride "texture" {
                                                                            texture = "gfx/interface/icons/tiered_interests/interest_levels_icons/interest_level_3_influential_small.dds"
                                                                        }
                                                                        blockoverride "growing" {
                                                                            visible = "[GetScriptedGui('bpm_cell_is_growing').IsShown(GuiScope.SetRoot(StateRegion.MakeScope).AddScope('action', ScriptContainer.MakeScope).End)]"
                                                                        }
                                                                        blockoverride "shrinking" {
                                                                            visible = "[Not(GetScriptedGui('bpm_cell_is_growing').IsShown(GuiScope.SetRoot(StateRegion.MakeScope).AddScope('action', ScriptContainer.MakeScope).End))]"
                                                                        }
                                                                    }
                                                                }
                                                                flowcontainer = {
                                                                    direction = horizontal
                                                                    parentanchor = vcenter
                                                                    margin_left = 10
                                                                    spacing = 10
                                                                    textbox = {
                                                                        raw_text = "BPM_PROGRESS_COLON"
                                                                        parentanchor = vcenter
                                                                        autoresize = yes
                                                                        margin_right = 4
                                                                        default_format = "#v;bold"
                                                                    }
                                                                    flowcontainer = {
                                                                        direction = horizontal
                                                                        parentanchor = vcenter
                                                                        spacing = 10
                                                                        bpm_revcell_setback_success = {
                                                                            parentanchor = vcenter
                                                                            blockoverride "has_setback_visibility" {
                                                                                visible = "[LessThan_CFixedPoint(ScriptContainer.MakeScope.GetVariableFromVariableMap('bpm_revcell_progress', StateRegion.MakeScope).GetValue, StateRegion.MakeScope.ScriptValue('bpm_revcell_base_progress'))]"
                                                                            }
                                                                            blockoverride "has_checkmark_visibility" {
                                                                                visible = "[GreaterThan_CFixedPoint(ScriptContainer.MakeScope.GetVariableFromVariableMap('bpm_revcell_progress', StateRegion.MakeScope).GetValue, StateRegion.MakeScope.ScriptValue('bpm_revcell_base_progress'))]"
                                                                            }
                                                                        }
                                                                        bpm_revcell_setback_success = {
                                                                            parentanchor = vcenter
                                                                            blockoverride "has_setback_visibility" {
                                                                                visible = "[LessThan_CFixedPoint(ScriptContainer.MakeScope.GetVariableFromVariableMap('bpm_revcell_progress', StateRegion.MakeScope).GetValue, StateRegion.MakeScope.ScriptValue('bpm_revcell_base_progress_m1'))]"
                                                                            }
                                                                            blockoverride "has_checkmark_visibility" {
                                                                                visible = "[GreaterThan_CFixedPoint(ScriptContainer.MakeScope.GetVariableFromVariableMap('bpm_revcell_progress', StateRegion.MakeScope).GetValue, StateRegion.MakeScope.ScriptValue('bpm_revcell_base_progress_p1'))]"
                                                                            }
                                                                        }
                                                                        bpm_revcell_setback_success = {
                                                                            parentanchor = vcenter
                                                                            blockoverride "has_setback_visibility" {
                                                                                visible = "[EqualTo_CFixedPoint(ScriptContainer.MakeScope.GetVariableFromVariableMap('bpm_revcell_progress', StateRegion.MakeScope).GetValue, StateRegion.MakeScope.ScriptValue('bpm_revcell_progress_min'))]"
                                                                            }
                                                                            blockoverride "has_checkmark_visibility" {
                                                                                visible = "[EqualTo_CFixedPoint(ScriptContainer.MakeScope.GetVariableFromVariableMap('bpm_revcell_progress', StateRegion.MakeScope).GetValue, StateRegion.MakeScope.ScriptValue('bpm_revcell_progress_max'))]"
                                                                            }
                                                                        }
                                                                    }
                                                                }

                                                                flowcontainer = {
                                                                    parentanchor = vcenter
                                                                    margin_left = 10
                                                                    textbox = {
                                                                        datacontext = "[ScriptContainer]"
                                                                        datacontext = "[StateRegion]"
                                                                        parentanchor = vcenter
                                                                        align = nobaseline
                                                                        text = "[GuiScope.SetRoot(StateRegion.MakeScope).AddScope('action', ScriptContainer.MakeScope).ScriptValue('bpm_revolt_progress_value_state')|v-=2]#N %#!"
                                                                        fontsize = 12
                                                                        autoresize = yes
                                                                        margin = { 7 4 }
                                                                        background = {
                                                                            using = entry_bg
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }

                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                hbox = {
                                    minimumsize = { -1 40}
                                }

                                #section_header_button = {
                                #     blockoverride "left_text" {
                                #         text = "bpm_potential_preparing_actions"
                                #     }

                                #     blockoverride "right_text" {
                                #         section_header_right_text = {
                                #             text = "bpm_dissent_actions_preparing_count"
                                #         }
                                #     }
                                #     blockoverride "onclick" {
                                #         onclick = "[GetVariableSystem.Toggle('bpm_preparing_dissent_actions')]"
                                #     }
                                    
                                #     blockoverride "onclick_showmore" {
                                #         visible = "[Not(GetVariableSystem.Exists('bpm_preparing_dissent_actions'))]"
                                #     }

                                #     blockoverride "onclick_showless" {
                                #         visible = "[GetVariableSystem.Exists('bpm_preparing_dissent_actions')]"
                                #     }
                                # }


#                                 flowcontainer = {
#                                     #parentanchor = hcenter
#                                     direction = horizontal
#                                     margin = { 10 0 }

#                                     datamodel = "[AccessPlayer.GetGroupsForInActiveJournalEntries]"

# #                                    visible = "[GetVariableSystem.Exists('bpm_preparing_dissent_actions')]"

#                                     #visible = "Not(IsDataModelEmpty(GetJournalEntryGroup('je_group_bpm_dissent').GetInactiveJournalEntryTypes(GetPlayer.Self)))"
#                                     item = {
#                                         flowcontainer = {
#                                             max_update_rate = 20
#                                             spacing = 4
#                                             #parentanchor = hcenter
#                                             visible = "[ObjectsEqual(MakeScopeFlag(GetJournalEntryGroup('je_group_bpm_dissent').GetName), MakeScopeFlag(JournalEntryGroup.GetName))]"
#                                             datamodel = "[JournalEntryGroup.GetInactiveJournalEntryTypes(GetPlayer.Self)]"
#                                             #datamodel = "[GetJournalEntryGroup('je_group_bpm_dissent').GetInactiveJournalEntryTypes(GetPlayer.Self)]"
#                                             direction = vertical
#                                             item = {
#                                                 bpm_political_situation_subversive_actions_preparing = {}
#                                             }


flowcontainer = {
	name = "widget_je_bpm_revolt_grasp"
	direction = vertical
	parentanchor = hcenter
	ignoreinvisible = yes

	flowcontainer = {
		direction = vertical
		parentanchor = hcenter
		spacing = 6
		margin_bottom = 8
		ignoreinvisible = yes

		background = {
			using = entry_bg_fancy_dark
			alpha = 0.2
			margin = { 10 0 }
		}

		section_header_button = {
			using = default_fade_in_out
			parentanchor = hcenter
			align = nobaseline
			size = { 540 44 }

			blockoverride "arrow_position" {
				position = { 2 0 }
				parentanchor = left|vcenter
			}
			blockoverride "left_textbox_margin_left" {
				margin_left = 30
			}
			blockoverride "left_text" {
				text = "BPM_GRASP_HEADER"
			}
			blockoverride "right_text" {
				section_header_right_text = {
					raw_text = "#v [JournalEntry.GetCountry.MakeScope.ScriptValue('bpm_revolt_states_with_cells')|0]#!"
					tooltip = "BPM_GRASP_HEADER_COUNT_TT"
				}
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('bpm_revolt_grasp_collapsed')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('bpm_revolt_grasp_collapsed')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('bpm_revolt_grasp_collapsed'))]"
			}
		}

		flowcontainer = {
			visible = "[Not(GetVariableSystem.Exists('bpm_revolt_grasp_collapsed'))]"
			direction = vertical
			parentanchor = hcenter

			flowcontainer = {
				parentanchor = hcenter

				bpm_je_grasp_card = {
					blockoverride "header_text" { text = "BPM_GRASP_BOX_1" }
					blockoverride "below_visible" { visible = "[GreaterThan_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)1')]" }
					blockoverride "above_visible" { visible = "[LessThan_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)1')]" }
					blockoverride "equal_visible" { visible = "[EqualTo_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)1')]" }
					blockoverride "selected_visible" { visible = "[EqualTo_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)1')]" }
					blockoverride "header_tooltip" { tooltip = "BPM_GRASP_BOX_1_TT" }
					blockoverride "states_datamodel" { datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('bpm_grasp_states_1')]" }
					blockoverride "empty_visible" { visible = "[IsDataModelEmpty(JournalEntry.GetCountry.MakeScope.GetList('bpm_grasp_states_1'))]" }
				}
				bpm_je_grasp_card = {
					blockoverride "header_text" { text = "BPM_GRASP_BOX_2" }
					blockoverride "below_visible" { visible = "[GreaterThan_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)2')]" }
					blockoverride "above_visible" { visible = "[LessThan_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)2')]" }
					blockoverride "equal_visible" { visible = "[EqualTo_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)2')]" }
					blockoverride "selected_visible" { visible = "[EqualTo_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)2')]" }
					blockoverride "header_tooltip" { tooltip = "BPM_GRASP_BOX_2_TT" }
					blockoverride "states_datamodel" { datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('bpm_grasp_states_2')]" }
					blockoverride "empty_visible" { visible = "[IsDataModelEmpty(JournalEntry.GetCountry.MakeScope.GetList('bpm_grasp_states_2'))]" }
				}
				bpm_je_grasp_card = {
					blockoverride "header_text" { text = "BPM_GRASP_BOX_3" }
					blockoverride "below_visible" { visible = "[GreaterThan_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)3')]" }
					blockoverride "above_visible" { visible = "[LessThan_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)3')]" }
					blockoverride "equal_visible" { visible = "[EqualTo_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)3')]" }
					blockoverride "selected_visible" { visible = "[EqualTo_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)3')]" }
					blockoverride "header_tooltip" { tooltip = "BPM_GRASP_BOX_3_TT" }
					blockoverride "states_datamodel" { datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('bpm_grasp_states_3')]" }
					blockoverride "empty_visible" { visible = "[IsDataModelEmpty(JournalEntry.GetCountry.MakeScope.GetList('bpm_grasp_states_3'))]" }
				}
			}

			flowcontainer = {
				parentanchor = hcenter

				bpm_je_grasp_card = {
					blockoverride "header_text" { text = "BPM_GRASP_BOX_4" }
					blockoverride "below_visible" { visible = "[GreaterThan_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)4')]" }
					blockoverride "above_visible" { visible = "[LessThan_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)4')]" }
					blockoverride "equal_visible" { visible = "[EqualTo_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)4')]" }
					blockoverride "selected_visible" { visible = "[EqualTo_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)4')]" }
					blockoverride "header_tooltip" { tooltip = "BPM_GRASP_BOX_4_TT" }
					blockoverride "states_datamodel" { datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('bpm_grasp_states_4')]" }
					blockoverride "empty_visible" { visible = "[IsDataModelEmpty(JournalEntry.GetCountry.MakeScope.GetList('bpm_grasp_states_4'))]" }
				}
				bpm_je_grasp_card = {
					blockoverride "header_text" { text = "BPM_GRASP_BOX_5" }
					blockoverride "below_visible" { visible = "[GreaterThan_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)5')]" }
					blockoverride "above_visible" { visible = "[LessThan_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)5')]" }
					blockoverride "equal_visible" { visible = "[EqualTo_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)5')]" }
					blockoverride "selected_visible" { visible = "[EqualTo_CFixedPoint(JournalEntry.GetCountry.MakeScope.Var('bpm_grasp_threshold').GetValue, '(CFixedPoint)5')]" }
					blockoverride "header_tooltip" { tooltip = "BPM_GRASP_BOX_5_TT" }
					blockoverride "states_datamodel" { datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('bpm_grasp_states_5')]" }
					blockoverride "empty_visible" { visible = "[IsDataModelEmpty(JournalEntry.GetCountry.MakeScope.GetList('bpm_grasp_states_5'))]" }
				}
			}
		}
	}
}

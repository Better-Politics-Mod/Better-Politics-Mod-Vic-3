Types action_types
{
	type bpm_action_revolt_item = flowcontainer {
		direction = vertical
		visible = "[And(ScriptContainer.IsValid, EqualTo_string(ScriptContainer.MakeScope.Var('bpm_action_type').GetFlagName, 'bpm_action_revolt'))]"

		block "tooltip" {
			tooltip = "BPM_ACTION_REVOLT_ITEM_TT"
		}

		widget = {
			block "button_size" {
				size = { 500 110 }
			}

			button = {
				parentanchor = center
				size = { 100% 100% }
				using = default_button
				block "onclick" {}

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin_left = 8
					margin_right = 15
					spacing = 8

					### ACTION ICON ###
					widget = {
						size = { 90 90 }

						icon = {
							using = rotate_glow_animation_02
							blockoverride "rotate_animation_texture" {
								texture = "gfx/interface/animation/color_bad.dds"
							}
							size = { 150% 150% }
							parentanchor = center
							alpha = 0.5
						}

						icon = {
							parentanchor = center
							size = { 80 80 }
							texture = "[GetInstitutionType(ScriptContainer.MakeScope.Var('bpm_action_type').GetFlagName).GetIcon]"
						}
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 0 6 }
						spacing = 3

						### ACTION NAME HEADER ###
						hbox = {
							layoutpolicy_horizontal = expanding
							margin = { 0 3 }

							background = {
								using = dark_area
								alpha = 0.4

								modify_texture = {
									texture = "gfx/interface/masks/fade_horizontal_center.dds"
									blend_mode = alphamultiply
								}
							}

							textbox = {
								layoutpolicy_horizontal = expanding
								size = { 0 20 }
								align = right|nobaseline
								elide = right
								fontsize_min = 12
								text = "[Localize(Concatenate(ScriptContainer.MakeScope.Var('bpm_action_type').GetFlagName, '_name'))]"
							}
						}

						### INVOLVED IGS + STATS ###
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 2

							flowcontainer = {
								parentanchor = vcenter
								spacing = 2
								datamodel = "[ScriptContainer.MakeScope.GetList('bpm_actively_involved')]"

								item = {
									ig_icon = {
										datacontext = "[Scope.GetInterestGroup]"
										blockoverride "button_size" {
											size = { 30 30 }
										}
									}
								}
							}

							expand = {}

							### total clout of involved IGs
							textbox = {
								autoresize = yes
								align = nobaseline
								fontsize_min = 12
								text = "BPM_ACTION_CLOUT_VALUE"
								tooltip = "BPM_ACTION_CLOUT_TT"
							}

							widget = {
								size = { 8 5 }
							}

							### number of states with revolutionary cells
							icon = {
								size = { 28 28 }
								texture = "gfx/interface/icons/political_movement_icons/political_activism_red.dds"
								tooltip = "BPM_ACTION_REVOLT_CELLS_TT"
							}

							textbox = {
								autoresize = yes
								align = nobaseline
								fontsize_min = 12
								text = "BPM_ACTION_REVOLT_CELLS_VALUE"
								tooltip = "BPM_ACTION_REVOLT_CELLS_TT"
							}
						}
					}
				}
			}
		}
	}
}

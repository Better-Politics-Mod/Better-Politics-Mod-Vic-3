    type bpm_political_situation_subversive_actions_potential = flowcontainer {
		direction = vertical
		minimumsize = { @panel_width -1 }		
		maximumsize = { @panel_width -1 }
		margin = { 10 10 }
		margin_top = 3
		spacing = 5		
        datacontext = "[AccessPlayer.GetJournalEntry(JournalEntryType.Self)]"
        visible = "[And(Not(JournalEntry.MakeScope.Var('bpm_front_currently_planning').IsSet), IsDataModelEmpty(JournalEntry.MakeScope.GetList('bpm_planning_subversive_action_ig')))]"
        background = {
			using = simple_frame
		}
		container = {
			minimumsize = { 536 -1 }
			parentanchor = hcenter

			flowcontainer = {
				minimumsize = { 536 -1 }
				parentanchor = vcenter
				spacing = 5
				margin_left = 10
				margin_top = 2
				margin_bottom = 2

				background = {
					using = fade_right_simple
				}

                    icon = {
                        size = { 32 32 }

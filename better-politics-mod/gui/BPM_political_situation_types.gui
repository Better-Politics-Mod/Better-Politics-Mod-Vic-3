                    autoresize = yes
                    align = nobaseline
                    margin_left = 10
                    parentanchor = vcenter
                }
                textbox = {
                    visible = "[Not(EqualTo_CFixedPoint(JournalEntry.GetBaselineValue, '(CFixedPoint)0'))]"
                    text = "JOURNAL_ENTRY_PROGRESSBAR_FROM_BASE"
                    autoresize = yes
                    align = nobaseline
                    margin_left = 10
                    parentanchor = vcenter
                }
            }

            hbox = { 
                minimumsize = { -1 6 }
                visible = "[And(JournalEntry.HasProgressBar, JournalEntry.IsActive)]"
            }
            divider_clean = {
                visible = "[And(JournalEntry.HasProgressBar, JournalEntry.IsActive)]"
            }

            textbox = {
                size = { 475 80 }
                visible = "[Not(JournalEntry.IsActive)]"
                text = "#tooltippable [JournalEntry.GetActivationTooltip]#!"

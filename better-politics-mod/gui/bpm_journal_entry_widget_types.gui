# COPY-PASTED FOR NOW
@panel_width_minus_30 = 510
@panel_width_minus_20 = 520			
@panel_width_minus_10 = 530			# used to be 450
@panel_width = 540  				# used to be 460
@panel_width_half = 270				# used to be 230
@panel_width_plus_10 = 550  		# used to be 470
@panel_width_plus_14 = 554			# used to be 474
@panel_width_plus_14_half = 277		# used to be 237
@panel_width_plus_20 = 560			# used to be 480
@panel_width_plus_30 = 570			# used to be 490
@panel_width_plus_70 = 610			# used to be 530

types bpm_journal_entry_widget_types {

    type bpm_je_widget_faction_item = flowcontainer {
        direction = vertical
        widget = { size = { @panel_width_plus_20 -1 }}

        flowcontainer = { 
            direction = vertical
            parentanchor = hcenter
            widget = { size = { @panel_width_plus_20 -1 }}
            using = entry_bg_fancy_solid_bg
            flowcontainer = { 

                direction = vertical
                section_header_button = {
                    blockoverride "left_text" {
                        text = "[Localize(Concatenate(ScriptContainer.MakeScope.Var('bpm_faction_type').GetFlagName, '_name'))]"
                        fontsize_min = 12
                        elide = right
                    }

                    blockoverride "onclick" {
                        onclick = "[GetVariableSystem.Toggle( ScriptContainer.MakeScope.Var('bpm_faction_type').GetFlagName )]"
                    }

                    blockoverride "onclick_showmore" {
                        visible = "[Not(GetVariableSystem.Exists( ScriptContainer.MakeScope.Var('bpm_faction_type').GetFlagName ))]"
                    }

                    blockoverride "onclick_showless" {
                        visible = "[GetVariableSystem.Exists( ScriptContainer.MakeScope.Var('bpm_faction_type').GetFlagName )]"
                    }
                }
                flowcontainer = {
                    direction = vertical
                    visible = "[GetVariableSystem.Exists( ScriptContainer.MakeScope.Var('bpm_faction_type').GetFlagName )]"
                    widget = { size = { @panel_width_plus_20 -1 }}
                    flowcontainer = {
                        direction = horizontal
                        wrap_count = 4
                        datamodel = "[GetPlayer.MakeScope.GetList('bpm_revolution_victory_igs')]"

                        item = {
                            ig_icon_large = { 
                                datacontext = "[Scope.GetInterestGroup]"
                                visible = "[GetScriptedGui('bpm_ig_in_faction').IsShown(GuiScope.SetRoot(InterestGroup.MakeScope).AddScope('faction', ScriptContainer.MakeScope).End)]"
                            }
                        }
                    }
                    divider_clean = {}
                    flowcontainer = {
                        direction = vertical
                        parentanchor = hcenter
                        margin = { 0 5 }
                        textbox = {
                            text = "BPM_REVOLUTIONARY_ZEAL"
                            default_format = "#header"
                            autoresize = yes
                            using = fontsize_large
                            parentanchor = hcenter
                        }
                        widget = {
                            size = { @panel_width 60 }
                            widget = { 
                                parentanchor = vcenter|hcenter
                                size = { @panel_width_minus_20 40 }
                                tooltip = "[Character.GetCustom('bpm_faction_zeal_level_tooltip')]"
                                vbox = {
                                    textbox = {
                                        layoutpolicy_horizontal = expanding
                                        datacontext = "[Character]"
                                        text = "BPM_REVOLUTIONARY_ZEAL_OVERBAR"
                                        autoresize = yes
                                        parentanchor = left
                                    }
                                    levels_progressbar = {
                                        parentanchor = hcenter
                                        size = { @panel_width_minus_20 20 }
                                        datamodel = "[GetGlobalList('bpm_sc_levels')]"
                                        blockoverride "item_properties" {
                                            size = { 0 20 }
                                        }
                                        blockoverride "level_active" {
                                            visible = "[GetScriptedGui('bpm_revolutionary_zeal_level_show_sgui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('faction', Character.MakeScope).AddScope('level', MakeScopeFlag( Scope.GetFlagName )).End)]"
                                        }
                                        blockoverride "last_level" {
                                            visible = "[Not(EqualTo_string( Scope.GetFlagName, 'lv4' ))]"
                                        }
                                        blockoverride "default_progressbar_value" {
                                            value = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('faction', Character.MakeScope).AddScope('level', MakeScopeFlag( Scope.GetFlagName )).ScriptValue('bpm_revolutionary_zeal_value')]"
                                        }
                                    }
                                }
                            }
                        }

                    }
                    divider_clean = {}
                    textbox = {
                        datacontext = "[Character]"
                        text = "BPM_FACTION_DEMANDS"
                       # background = {
                       #     using = entry_bg
                      # }
                        maximumsize = { @panel_width_minus_20 -1 }
                        multiline = yes
                        parentanchor = left
                        margin = { 15 5 }
                        autoresize = yes
                    }
                    margin_bottom = 10
                }

            }
        }
    }

    type ig_icon_large = widget {
        size = { 108 120 }
        using = tooltip_se

        flowcontainer = {
            parentanchor = center
            direction = vertical
            spacing = 5
            margin = { 10 5 }

            background = {
                using = entry_bg_simple_solid
                color = "[InterestGroup.GetColor]"
                alpha = 0.6

                modify_texture = {
                    using = texture_velvet
                }
            }

            ig_button = {
                size = { 70 70 }
                parentanchor = hcenter
            }


            textbox = {
                name = "approval"
                parentanchor = hcenter
                align = nobaseline
                autoresize = yes
                raw_text = "#v @bpm_heart! [InterestGroup.GetApprovalValue|=+]#!"
            }
        }
	}

	type bpm_je_grasp_card = widget {
		size = { 172 196 }

		widget = {
			size = { 168 192 }
			parentanchor = center

			background = {
				using = entry_bg_fancy_dark

				modify_texture = {
					spriteType = Corneredstretched
					spriteborder = { 0 0 }
					blend_mode = add
					alpha = 0.3
					texture = "gfx/interface/backgrounds/paper_texture.dds"
				}
			}

			vbox = {
				size = { 100% 100% }
				margin = { 6 6 }

				default_header_clean = {
					block "header_tooltip" {}
					blockoverride "header_background" {
						# card equal to the grasp threshold: default look
						background = {
							block "equal_visible" {}
							using = entry_bg_mask_top
						}

						# card below the grasp threshold: red
						background = {
							block "below_visible" {
								visible = no
							}
							texture = "gfx/interface/backgrounds/white.dds"
							color = { 0.88 0.34 0.34 1.0 }
							alpha = 0.5
							using = entry_bg_mask_top
						}

						# card above the grasp threshold: green
						background = {
							block "above_visible" {
								visible = no
							}
							texture = "gfx/interface/backgrounds/white.dds"
							color = { 0.39 0.67 0.33 1.0 }
							alpha = 0.5
							using = entry_bg_mask_top
						}

						background = {
							using = entry_bg_mask_top
							color = { 0.0 0.0 0.0 1.0 }
							alpha = 0.3
							texture = "gfx/interface/backgrounds/white.dds"

							modify_texture = {
								spriteType = Corneredstretched
								spriteborder = { 0 0 }
								blend_mode = alphamultiply
								texture = "gfx/interface/masks/fade_vertical_top.dds"
							}
						}
					}

					blockoverride "size" {
						layoutpolicy_horizontal = expanding
						size = { 0 30 }
					}

					blockoverride "text_size" {
						using = fontsize_large
					}

					blockoverride "text_mod" {
						max_width = 150
					}

					blockoverride "text" {
						block "header_text" {
							text = "BPM_GRASP_BOX_1"
						}
					}
				}

				empty_state = {
					layoutpolicy_horizontal = expanding
					blockoverride "visible" {
						block "empty_visible" {}
					}
					blockoverride "margin" {
						margin_top = 20
					}
					blockoverride "fontsize" {
						using = fontsize_large
					}
					# card inner width: 168 - 2*6 margin
					blockoverride "size" {
						minimumsize = { 156 -1 }
						maximumsize = { 156 -1 }
						max_width = 156
					}
					blockoverride "text" {
						text = "BPM_GRASP_BOX_EMPTY"
					}
				}

				scrollarea = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					scrollbarpolicy_horizontal = always_off

					scrollbar_vertical = {
						using = vertical_scrollbar
					}

					scrollwidget = {
						flowcontainer = {
							direction = vertical

							block "states_datamodel" {
								datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('bpm_grasp_states_1')]"
							}

							item = {
								bpm_je_grasp_state_entry = {
									datacontext = "[Scope.GetState]"
								}
							}
						}
					}
				}
			}

			# selection frame on the card equal to the grasp threshold (as on vanilla selected scripted buttons)
			icon = {
				block "selected_visible" {
					visible = no
				}
				using = highlighted_square_selection
				size = { 160 184 } # card is 168x192, inset 4px on each side so the frame sits inside the card border
				alwaystransparent = yes
			}
		}
	}

	type bpm_je_grasp_state_entry = widget {
		size = { 152 30 }
		onmousehierarchyenter = "[AccessHighlightManager.HighlightState(State.Self)]"
		onmousehierarchyleave = "[AccessHighlightManager.RemoveHighlight]"
		alwaystransparent = no

		divider_clean = {
			size = { 100% 1 }
		}

		hbox = {
			button = {
				using = default_button
				layoutpolicy_horizontal = expanding
				size = { 0 26 }
				onclick = "[InformationPanelBar.OpenStatePanel(State.AccessSelf)]"
				onrightclick = "[RightClickMenuManager.ShowForState(State.AccessSelf)]"

				tooltipwidget = {
					FancyTooltip_State = {}
				}

				textbox = {
					size = { 100% 100% }
					text = "[State.GetName]"
					align = left|nobaseline
					margin = { 8 0 }
					elide = right
				}
			}

			# existing revolutionary cells: count + highest level
			flowcontainer = {
				visible = "[GreaterThan_CFixedPoint(State.MakeScope.ScriptValue('bpm_revolt_map_cells_in_state'), '(CFixedPoint)0')]"
				tooltip = "BPM_GRASP_STATE_CELLS_TT"
				spacing = 1
				margin_left = 2

				textbox = {
					parentanchor = vcenter
					autoresize = yes
					align = nobaseline
					raw_text = "#v [State.MakeScope.ScriptValue('bpm_revolt_map_cells_in_state')|0]#!"
				}

				icon = {
					visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('bpm_revolt_map_max_cell_level'), '(CFixedPoint)1')]"
					parentanchor = vcenter
					size = { 24 24 }
					texture = "gfx/interface/icons/tiered_interests/interest_levels_icons/interest_level_1_observant_small.dds"
				}
				icon = {
					visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('bpm_revolt_map_max_cell_level'), '(CFixedPoint)2')]"
					parentanchor = vcenter
					size = { 24 24 }
					texture = "gfx/interface/icons/tiered_interests/interest_levels_icons/interest_level_2_engaged_small.dds"
				}
				icon = {
					visible = "[EqualTo_CFixedPoint(State.MakeScope.ScriptValue('bpm_revolt_map_max_cell_level'), '(CFixedPoint)3')]"
					parentanchor = vcenter
					size = { 24 24 }
					texture = "gfx/interface/icons/tiered_interests/interest_levels_icons/interest_level_3_influential_small.dds"
				}
			}
		}
	}
}